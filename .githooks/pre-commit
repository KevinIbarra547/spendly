#!/bin/sh
# Spendly loop guard: never commit directly on main (see AGENTS.md "The loop").
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "BLOCKED: you are on '$branch'. Start a task branch with /start-task <issue#> (e.g. feat/12-short-name)." >&2
  exit 1
fi
exit 0
