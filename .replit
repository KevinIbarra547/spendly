modules = ["web", "nodejs-24", "python-base-3.13"]
run = "npm run build && npm start"

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
build = "npm run build"
run = "npm start"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build && npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
