{
  "name": "spendly",
  "version": "0.1.0",
  "description": "Spendly - A money-life simulation web app for students ages 13+",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build",
    "dev": "vite",
    "dev:backend": "ts-node-dev src/backend/index.ts",
    "start": "node dist/backend/index.js",
    "lint": "eslint . --fix",
    "lint:no-fix": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:reference",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:contracts": "jest --testPathPattern=contracts",
    "test:regression": "jest --testPathPattern=regression",
    "test:reference": "python tests/fixtures/consumer_agents_reference.py",
    "test:watch": "jest --watch",
    "prepare": "husky install"
  },
  "keywords": [
    "education",
    "finance",
    "simulation",
    "gamification",
    "learning"
  ],
  "author": "Spendly Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "zod": "^3.22.4",
    "three": "^0.147.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.10.9",
    "@types/node": "^20.11.5",
    "@types/three": "^0.147.0",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "vite": "^5.0.12",
    "@vitejs/plugin-react": "^4.2.1",
    "ts-node-dev": "^2.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
